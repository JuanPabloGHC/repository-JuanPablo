---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { Project } from "types/project";
import { technologies } from "data/technologies";
import { categories } from "data/categories";

interface Props {
    project: Project
}

const { project } = Astro.props;

// Icon shown next to each link: GitHub repos by URL, otherwise by name.
const iconFor = (link: { name: string; url: string }) => {
    if (link.url.includes("github.com")) return "mdi:github";

    const name = link.name.toLowerCase();
    if (name.includes("demo") || name.includes("play")) return "mdi:open-in-new";

    return "mdi:link-variant";
};
---

<li
    class="project group card flex flex-col px-5 pb-2 pt-5 gap-2 justify-between rounded-lg bg-white dark:bg-neutral-900 w-full h-full"
    data-categories={project.categories.join(" ")}
>

    <div class="flex w-full relative">
        <Image
            class="w-full h-52 object-cover rounded-md"
            src={project.image}
            alt=`${project.title} Project image`
        />

        <div class="absolute top-0 left-0 rounded-md w-full h-full bg-primary/70 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition duration-300 ease-in-out">
            <ul class="flex flex-wrap w-full h-full content-center justify-center items-center gap-x-2 gap-y-2 p-4">
                {
                    project.technologies.map((key) => {
                        const tech = technologies[key];
                        return (
                            <li class="flex flex-col items-center gap-1 w-16">
                                <Icon name={tech.icon} class="w-10 h-10 3xl:w-12 3xl:h-12" />
                                <span class="text-[10px] leading-tight text-center text-black">
                                    {tech.name}
                                </span>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </div>

    <h3 class="text-lg font-bold">
        {project.title}
    </h3>

    <ul class="flex flex-wrap gap-1.5">
        {
            project.categories.map((key) => (
                <li class="text-[10px] font-semibold uppercase tracking-wide text-primary bg-primary/10 rounded-full px-2 py-0.5">
                    {categories[key]}
                </li>
            ))
        }
    </ul>

    <p class="text-sm text-justify hyphens-auto">
        {project.description}
    </p>

    <ul class="w-full flex gap-2 items-center justify-end p-5">
        {
            project.links.map((link) => (
                <li>
                    <a
                        id={`watch it on ${link.url}`}
                        target="_blank"
                        class="flex items-center gap-1.5 text-sm py-2 px-5 rounded-full bg-primary/10 hover:cursor-pointer hover:text-primary hover:shadow-lg hover:shadow-primary/80 transition duration-300 ease-in-out"
                        href={link.url}
                    >
                        <Icon name={iconFor(link)} class="w-4 h-4" />
                        {link.name}
                    </a>
                </li>
            ))
        }
    </ul>

</li>

<style>
    .card {

        box-shadow: 0 0 4px 5px rgba(20, 184, 166, 0.1),
                    0 1px 3px rgba(20, 184, 166, 0.06);
    }
</style>
