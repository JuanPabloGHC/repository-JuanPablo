---
import { Icon } from 'astro-icon/components'
import type { Experience } from 'types/experience'
import { formatDuration } from 'lib/duration'

interface Props {
    experience: Experience
}

const { experience } = Astro.props
---

<li class="card flex flex-col px-5 py-2 gap-5 justify-between rounded-lg bg-tertiary w-full h-full">

    <h3 class="text-xl font-bold">
        {experience.title}
    </h3>

    <div class="flex items-center gap-5 w-full h-full justify-start">
        <Icon name="mdi:company" aria-label="company icon" class="w-1/6 md:w-6 h-6 text-secondary" />
        <p class="text-md text-start w-5/6 md:w-full">
            {experience.company}
        </p>
    </div>

    <div class="flex items-center gap-5 w-full h-full justify-start">
        <Icon name="mdi:calendar" aria-label="calendar icon" class="w-1/6 md:w-6 h-6 text-secondary" />
        <p class="text-md text-start w-5/6 md:w-full">
            {experience.dateStart.toDateString()} - {experience.current ? "Present" : experience.dateEnd.toDateString()} (<span
                class="experience-time"
                data-current={experience.current ? "true" : "false"}
                data-start={experience.dateStart.toISOString()}
            >{formatDuration(experience.dateStart, experience.current ? new Date() : experience.dateEnd)}</span>)
        </p>
    </div>

    <p class="text-md text-justify hyphens-auto">
        {experience.description}
    </p>

    <ul class="flex flex-wrap lg:grid lg:grid-cols-3 justify-start gap-5">
        {
            experience.aptitudes.map((aptitude) => (
                <li>                    
                    <p class="text-sm text-secondary font-bold">
                        {aptitude}
                    </p>
                </li>
            ))
        }
    </ul>

</li>

<style>
    .card {

        box-shadow: 0 0 4px 5px rgba(14, 116, 144, 0.1),
                    0 1px 3px rgba(14, 116, 144, 0.06);
    }
</style>

<script>
    import { formatDuration } from "lib/duration";

    // The site is built statically, so a build-time "now" would freeze the
    // duration of current jobs. Recompute them in the browser on every visit.
    document.querySelectorAll<HTMLElement>(".experience-time").forEach((el) => {
        if (el.dataset.current !== "true" || !el.dataset.start) return;

        el.textContent = formatDuration(new Date(el.dataset.start), new Date());
    });
</script>